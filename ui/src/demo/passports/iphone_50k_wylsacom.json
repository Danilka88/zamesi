    {
      "speaker": "Ведущий",
      "start_sec": 707,
      "end_sec": 721,
      "text": "iPhone 17E идёт с 256 ГБ на борту, добавлен MagSafe. Процессор A19 вышел в марте этого года. Свежачок.",
      "word_timestamps": [
        {
          "word": "iPhone",
          "start_sec": 707,
