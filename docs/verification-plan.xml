<?xml version="1.0" encoding="UTF-8"?>
<verification-plan project="RUTUBE Video Analyzer" version="0.1.0">
  <Policy>
    <logFormat>JSON (structlog) — correlation_id, module, timestamp, event</logFormat>
    <redaction>Логи не содержат сырых аудио/видео данных, только job_id + метаданные</redaction>
    <deterministicFirst>true</deterministicFirst>
    <tcoValidation>
      <vlmCallsMaxPercent>6</vlmCallsMaxPercent>
      <costPerHourMax>0.0025</costPerHourMax>
    </tcoValidation>
  </Policy>

  <Entries>
    <V-M-CORE module-ref="M-CORE" priority="high">
      <description>Валидация Pydantic-моделей, загрузка конфига, корректность типов, TimeoutManager</description>
      <Scenarios>
        <Scenario id="S-M-CORE-1" type="success">
          <description>JobStatus enum и Pydantic-модели: все значения корректны</description>
          <commands>
            <command>pytest tests/core/test_schemas.py -v -k "test_valid_frontmatter or test_frontmatter_brand_safety"</command>
          </commands>
          <evidence>
            <marker required="true">[M-CORE][SCHEMAS][VALID_ENUM]</marker>
            <assert>Pydantic валидирует JobStatus, PassportFrontmatter, SceneAnalysisResult, MonetizationItem</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-CORE-2" type="success">
          <description>SceneAnalysisResult с монетизацией: корректная структура</description>
          <commands>
            <command>pytest tests/core/test_schemas.py -v -k "test_scene_result"</command>
          </commands>
          <evidence>
            <marker required="true">[M-CORE][SCHEMAS][MONETIZATION]</marker>
            <assert>MonetizationItem, ClipCandidate корректно сериализуются; monetization включает ad_slot</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-CORE-3" type="success">
          <description>TimeoutManager: retry + fallback chain</description>
          <commands>
            <command>pytest tests/core/test_timeout_manager.py -v</command>
          </commands>
          <evidence>
            <marker required="true">[M-CORE][TIMEOUT][RETRY]</marker>
            <assert>Timeout → retry → RetryExhaustedError; circuit breaker открывается после порога</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-CORE-4" type="failure">
          <description>Circuit breaker: открывается после threshold, блокирует вызовы</description>
          <commands>
            <command>pytest tests/core/test_timeout_manager.py -v -k "circuit_breaker"</command>
          </commands>
          <evidence>
            <marker required="true">[M-CORE][CB][OPENED]</marker>
            <assert>CircuitBreakerOpenError после 3+ ошибок; восстанавливается в half-open</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-CORE][*][*]</marker>
      </RequiredMarkers>
    </V-M-CORE>

    <V-M-AUDIO module-ref="M-AUDIO" priority="high">
      <description>Извлечение аудио (ffmpeg), ASR, диаризация, сборка таймлайна</description>
      <Scenarios>
        <Scenario id="S-M-AUDIO-1" type="success">
          <description>Timeline merger: корректное присвоение спикера</description>
          <commands>
            <command>pytest tests/audio_engine/test_timeline_merger.py -v</command>
          </commands>
          <evidence>
            <marker required="true">[M-AUDIO][MERGE][SPEAKER_ASSIGNED]</marker>
            <assert>ASR-сегмент получает speaker из диаризации; fallback на 'unknown'</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-AUDIO][*][*]</marker>
      </RequiredMarkers>
    </V-M-AUDIO>

    <V-M-VISION module-ref="M-VISION" priority="high">
      <description>Genre classification, DomainRouter, OCR, OCR-буфер</description>
      <Scenarios>
        <Scenario id="S-M-VISION-1" type="success">
          <description>DomainRouter: keyword fallback для разных жанров</description>
          <commands>
            <command>pytest tests/vision_scanner/test_domain_router.py -v -k "test_keyword_fallback"</command>
          </commands>
          <evidence>
            <marker required="true">[M-VISION][ROUTER][KEYWORD_FALLBACK]</marker>
            <assert>Для подкастов/лекций domain_router возвращает соответствующий жанр</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-VISION-2" type="success">
          <description>DomainRouter: is_vision_blocked для разных жанров</description>
          <commands>
            <command>pytest tests/vision_scanner/test_domain_router.py -v -k "test_is_vision_blocked"</command>
          </commands>
          <evidence>
            <marker required="true">[M-VISION][ROUTER][VISION_BLOCKED]</marker>
            <assert>is_vision_blocked возвращает True для podcast/lecture, False для how_to</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-VISION-3" type="success">
          <description>OCR-буфер: поиск текста в окне ±5с</description>
          <commands>
            <command>pytest tests/vision_scanner/test_ocr_buffer.py -v</command>
          </commands>
          <evidence>
            <marker required="true">[M-VISION][OCR_BUFFER][WINDOW_CHECK]</marker>
            <assert>Текст в окне ±5с возвращается; вне окна — None; множественные результаты объединяются</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-VISION][*][*]</marker>
      </RequiredMarkers>
    </V-M-VISION>

    <V-M-SEMANTIC module-ref="M-SEMANTIC" priority="critical">
      <description>SLM-анализ (gemma4:e4b), VLM Gatekeeper, analyze_scenes. Критично для TCO.</description>
      <Scenarios>
        <Scenario id="S-M-SEMANTIC-1" type="success">
          <description>qwen_client: analyze_text_segment возвращает JSON, analyze_vision_segment, generate_frontmatter</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_qwen_client.py -v -k "test_analyze_text_segment or test_analyze_vision_segment or test_generate_frontmatter"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][QWEN][TEXT_ANALYSIS]</marker>
            <assert>analyze_text_segment возвращает JSON с action_is_clear; analyze_vision_segment обрабатывает base64; generate_frontmatter работает</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-SEMANTIC-2" type="failure">
          <description>qwen_client: _extract_json_checked рейзит JSONParseError на пустом/невалидном JSON</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_qwen_client.py -v -k "test_extract_json_checked_raises"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][QWEN][EXTRACT_FAILED]</marker>
            <assert>Пустой ответ → JSONParseError; невалидный JSON → JSONParseError; markdown fences стрипаются</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-SEMANTIC-3" type="success">
          <description>analyze_scenes: базовый сценарий с монетизацией</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_scene_analyzer.py -v -k "test_analyze_scenes_basic"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][SCENE][BASIC]</marker>
            <assert>1 сегмент → 1 SceneAnalysisResult с action_is_clear=True</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-SEMANTIC-4" type="failure">
          <description>analyze_scenes: ошибка LLM → fallback_used=llm_failed</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_scene_analyzer.py -v -k "test_analyze_scenes_llm_error"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][SCENE][LLM_FAILED]</marker>
            <assert>При ошибке LLM возвращается результат с fallback_used=llm_failed, пустой monetization</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-SEMANTIC-5" type="success">
          <description>analyze_scenes: VLM gate — vision_blocked=False → VLM вызывается</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_scene_analyzer.py -v -k "test_analyze_scenes_vision_gate"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][SCENE][VLM_CALLED]</marker>
            <assert>requires_vision=True + vision_blocked=False → vlm_calls=1, [Видео: …] в summary</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-SEMANTIC-6" type="success">
          <description>analyze_scenes: VLM gate — vision_blocked=True → VLM не вызывается</description>
          <commands>
            <command>pytest tests/semantic_analyzer/test_scene_analyzer.py -v -k "test_analyze_scenes_vision_blocked_suppresses_vlm"</command>
          </commands>
          <evidence>
            <marker required="true">[M-SEMANTIC][SCENE][VLM_BLOCKED]</marker>
            <assert>vision_blocked=True → vlm_calls=0, [Видео: …] отсутствует</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-SEMANTIC][*][*]</marker>
      </RequiredMarkers>
    </V-M-SEMANTIC>

    <V-M-PASSPORT module-ref="M-PASSPORT" priority="high">
      <description>Генерация YAML-frontmatter, Markdown-таймлайн, валидация .md</description>
      <Scenarios>
        <Scenario id="S-M-PASSPORT-1" type="success">
          <description>Валидация: корректный паспорт проходит без ошибок</description>
          <commands>
            <command>pytest tests/passport_builder/test_validator.py -v -k "test_valid_passport"</command>
          </commands>
          <evidence>
            <marker required="true">[M-PASSPORT][VALIDATE][PASS]</marker>
            <assert>Паспорт с video_id и корректными таймкодами — 0 ошибок</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-PASSPORT-2" type="failure">
          <description>Валидация: ошибка при отсутствии video_id</description>
          <commands>
            <command>pytest tests/passport_builder/test_validator.py -v -k "test_missing_video_id"</command>
          </commands>
          <evidence>
            <marker required="true">[M-PASSPORT][VALIDATE][MISSING_ID]</marker>
            <assert>Пустой video_id → ошибка валидации</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-PASSPORT-3" type="failure">
          <description>Валидация: ошибка при ECOM_ITEM без search_query</description>
          <commands>
            <command>pytest tests/passport_builder/test_validator.py -v -k "test_ecom_without"</command>
          </commands>
          <evidence>
            <marker required="true">[M-PASSPORT][VALIDATE][ECOM_NO_QUERY]</marker>
            <assert>ECOM_ITEM без search_query → ошибка валидации</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-PASSPORT-4" type="failure">
          <description>Валидация: strict mode рейзит ValidationError</description>
          <commands>
            <command>pytest tests/passport_builder/test_validator.py -v -k "test_strict_mode_raises"</command>
          </commands>
          <evidence>
            <marker required="true">[M-PASSPORT][VALIDATE][STRICT]</marker>
            <assert>strict=True с ошибками → ValidationError</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-PASSPORT][*][*]</marker>
      </RequiredMarkers>
    </V-M-PASSPORT>

    <V-M-API module-ref="M-API" priority="high">
      <description>FastAPI-endpoints, job queue, оркестрация, метрики</description>
      <Scenarios>
        <Scenario id="S-M-API-1" type="success">
          <description>GET /health: сервис отвечает</description>
          <commands>
            <command>pytest tests/api/test_endpoints.py -v -k "test_health"</command>
          </commands>
          <evidence>
            <marker required="true">[M-API][HEALTH][OK]</marker>
            <assert>Статус 200; тело содержит status: ok</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-API-2" type="success">
          <description>GET /metrics: Prometheus-метрики доступны</description>
          <commands>
            <command>pytest tests/api/test_endpoints.py -v -k "test_metrics_endpoint"</command>
          </commands>
          <evidence>
            <marker required="true">[M-API][METRICS][PROMETHEUS]</marker>
            <assert>Статус 200; тело содержит pipeline_ префикс метрик</assert>
          </evidence>
        </Scenario>
        <Scenario id="S-M-API-3" type="failure">
          <description>GET /analyze/{unknown_id}: 404</description>
          <commands>
            <command>pytest tests/api/test_endpoints.py -v -k "test_get_unknown_job or test_get_unknown_status"</command>
          </commands>
          <evidence>
            <marker required="true">[M-API][GET][JOB_NOT_FOUND]</marker>
            <assert>Статус 404 для несуществующего job_id</assert>
          </evidence>
        </Scenario>
      </Scenarios>
      <RequiredMarkers>
        <marker>[M-API][*][*]</marker>
      </RequiredMarkers>
    </V-M-API>
  </Entries>

  <Gates>
    <Gate level="module">
      <check>lint: ruff check src/ tests/</check>
      <check>type-check: mypy src/</check>
      <check>unit-tests: pytest tests/ --timeout=30 -x -q</check>
    </Gate>
    <Gate level="phase">
      <check>integration-tests: pytest tests/test_integration.py --timeout=3600 -v</check>
      <check>all-tests: pytest tests/ --timeout=60 -v</check>
    </Gate>
    <Gate level="release">
      <check>full-suite: pytest tests/ --timeout=600 -v --junitxml=report.xml</check>
      <check>VLM-ratio-check: python scripts/check_vlm_ratio.py &lt; 0.06</check>
    </Gate>
  </Gates>
</verification-plan>
