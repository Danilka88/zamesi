<?xml version="1.0" encoding="UTF-8"?>
<technology project="RUTUBE Video Analyzer" version="0.1.0">
  <runtime language="Python" version="3.13+"/>
  <framework name="FastAPI" version="0.115+"/>
  <pydantic version="2.0+">
    <description>Все межмодульные контракты — Pydantic v2 модели в модуле core</description>
  </pydantic>

  <key-libraries>
    <library name="ffmpeg" version="7+" purpose="Демодуляция MP4, извлечение аудио (subprocess) и I-frame"/>
    <library name="whisper.cpp" version="large-v3" purpose="ASR транскрибация (локально, через whisper-cli)"/>
    <library name="speechbrain" version="1.0+" purpose="ECAPA-TDNN диаризация спикеров"/>
    <library name="silero-vad" version="5.0+" purpose="Voice Activity Detection"/>
    <library name="rapidocr-onnxruntime" version="1.2+/v4" purpose="OCR текста с кадров (ONNX)"/>
    <library name="onnxruntime" version="1.18+" purpose="Рантайм для OCR"/>
    <library name="httpx" version="0.27+" purpose="HTTP-клиент к Ollama API"/>
    <library name="pyyaml" version="6.0+" purpose="YAML-frontmatter для .md паспортов"/>
    <library name="structlog" version="24.0+" purpose="Структурированное логирование"/>
    <library name="prometheus-client" version="0.20+" purpose="Prometheus-метрики"/>
    <library name="python-multipart" version="0.0.12+" purpose="Загрузка видеофайлов"/>
    <library name="uvicorn" version="standard" purpose="ASGI-сервер для FastAPI"/>
    <library name="anyio" version="4.0+" purpose="Async-рантайм для asyncio-совместимости"/>
    <library name="librosa" version="0.10+" purpose="Audio fingerprinting (спектрограммы, STFT, поиск пиков)"/>
    <library name="chromadb" version="1.5+" purpose="Vector search (Rust core, embedded mode)"/>
  </key-libraries>

  <testing>
    <runner>pytest 8.0+</runner>
    <extensions>pytest-asyncio, pytest-benchmark, pytest-timeout</extensions>
    <mock>unittest.mock + monkeypatch (встроен)</mock>
    <type-hinting>mypy 1.11+ (strict=false, warn_unused_configs)</type-hinting>
    <linter>ruff 0.5+ (E,F,I,N,W)</linter>
  </testing>

  <observability>
    <logger>structlog</logger>
    <format>JSON (correlation_id на job, module, timestamp)</format>
    <metrics>prometheus-client: latency_histogram, vlm_calls_total, json_errors_total, timeouts_total, fallbacks_total</metrics>
    <redaction>Логи не содержат сырых аудио/видео данных, только ссылки на job_id</redaction>
  </observability>

  <ai-models>
    <slm name="gemma4:e4b" provider="Ollama" endpoint="http://localhost:11434" purpose="Текстовый пайплайн (pass1 text analysis)">
      <params temperature="0.1" max_tokens="4096"/>
    </slm>
    <classifier name="qwen3.5:0.8b" provider="Ollama" endpoint="http://localhost:11434" purpose="Genre classification (LLM-driven)">
      <params temperature="0.1" max_tokens="8192"/>
    </classifier>
    <vlm name="qwen3.5:9b (Vision)" provider="Ollama" endpoint="http://localhost:11434" purpose="Визуальный анализ I-frame (Gatekeeper)" weight="≤6% сегментов">
      <params temperature="0.1" max_tokens="4096"/>
    </vlm>
    <asr name="Whisper large-v3" provider="whisper.cpp" binary="whisper-cli"/>
    <diarization name="SpeechBrain ECAPA-TDNN + Silero VAD" provider="speechbrain"/>
    <ocr name="RapidOCR v4" provider="onnxruntime"/>
    <embedding name="qwen3-embedding:0.6b" provider="Ollama" endpoint="http://localhost:11434" purpose="Embedding для семантического поиска (multilingual, 1024-dim)">
      <params MTEB="64.33"/>
    </embedding>

    <llm-router>
      <description>Multi-provider fallback chain. Primary → fallback → fallback при ошибке. Per-provider circuit breaker + latency tracking.</description>
      <provider name="ollama" type="ollama" endpoint="http://localhost:11434" purpose="Локальный LLM (dev, sensitive data)"/>
      <provider name="yandex" type="openai-compat" endpoint="https://llm.api.cloud.yandex.net/foundationModels/v1" purpose="Российский облачный LLM"/>
      <provider name="cloudru" type="openai-compat" endpoint="https://api.cloud.ru/v1" purpose="Российский облачный LLM (openai-compat)"/>
      <provider name="openrouter" type="openai-compat" endpoint="https://openrouter.ai/api/v1" purpose="Глобальный multi-model hub"/>
    </llm-router>
  </ai-models>

  <constraints>
    <constraint>VLM Gatekeeper: ≤6% всех сегментов проходят через Vision-модель</constraint>
    <constraint>Себестоимость пайплайна &lt;$0.0025/час видео (CPU-only, локальные модели)</constraint>
    <constraint>Все внешние вызовы защищены circuit breaker + retry + fallback chain + multi-provider fallback</constraint>
    <constraint>Таймаут pipeline: 3600 сек (pipeline_total); каждый под-таймаут индивидуален (qwen_pass1_text: 180, qwen_pass2_vision: 300, domain_router: 120)</constraint>
    <constraint>Нет веб-сервера зависимостей: Whisper, SpeechBrain, RapidOCR — локальный запуск</constraint>
  </constraints>
</technology>
