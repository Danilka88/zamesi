  <DataFlows>
    <Flow id="DF-001" name="Audio-First Pipeline">
      <description>MP4 → аудио → ASR → диаризация → таймлайн</description>
      <steps>M-AUDIO.extract_audio → M-AUDIO.transcribe → M-AUDIO.diarize → M-AUDIO.merge_timeline</steps>
    </Flow>
    <Flow id="DF-002" name="VLM Gatekeeper Flow">
      <description>Трёхуровневая фильтрация VLM-вызовов: жанр → requires_vision → OCR → Vision</description>
      <steps>M-VISION.extract_iframes → M-VISION.ocr_frame → M-VISION.detect_genre → M-SEMANTIC.analyze_scenes</steps>
    </Flow>
    <Flow id="DF-003" name="Passport Generation Flow">
      <description>Финальная сборка .md паспорта</description>
      <steps>M-PASSPORT.build_frontmatter → M-PASSPORT.build_passport → M-PASSPORT.validate</steps>
    </Flow>
    <Flow id="DF-004" name="API Orchestration Flow">
      <description>Полный цикл: загрузка → пайплайн → результат</description>
      <steps>M-API.POST /analyze → DF-001 → DF-002 → DF-003 → M-API.GET /analyze/{id}/markdown</steps>
    </Flow>
    <Flow id="DF-005" name="Search Flow">
      <description>Passport → index → search</description>
      <steps>M-PASSPORT.build_passport → M-SEARCH.index_passport → M-SEARCH.search_scenes</steps>
    </Flow>
    <Flow id="DF-006" name="Mix Flow">
      <description>Query → stages → search → compose → render</description>
      <steps>M-MIXER.plan_stages → M-MIXER.search_scenes → M-MIXER.compose_mix → M-MIXER.mix_to_md</steps>
    </Flow>
    <Flow id="DF-007" name="Extension Injection Flow">
      <description>Детект видео-страницы → подбор паспорта → монтаж Shadow DOM</description>
      <steps>M-EXTENSION.isVideoPage → M-EXTENSION.parseVideoId → M-EXTENSION.resolveBinding → M-EXTENSION.mountHost</steps>
    </Flow>
    <Flow id="DF-008" name="Extension Analyst Flow">
      <description>Паспорт → панели монетизации/модерации/аудио/метрики в сайдбаре</description>
      <steps>M-EXTENSION.getPassport → M-EXTENSION.computeMetrics → M-EXTENSION.renderAnalyst → M-EXTENSION.renderCta</steps>
    </Flow>
    <Flow id="DF-009" name="Offers Flow">
      <description>Паспорт → detect_offers → offers API (merch/travel/game/bike-search)</description>
      <steps>M-OFFERS.detect_offers → M-API.GET /api/v1/offers/* → M-EXTENSION.mountMerchOffer|mountTravelOffer|mountGameOffer</steps>
    </Flow>
    <Flow id="DF-010" name="Studio Flow">
      <description>Запрос → trends/referral/promotion bundles → studio API → RUTUBE Studio panel</description>
      <steps>M-STUDIO.build_trends_bundle → M-STUDIO.build_referral_bundle → M-API.GET /api/v1/studio/* → M-EXTENSION.mountStudioPanel</steps>
    </Flow>
  </DataFlows>
