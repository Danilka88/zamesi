<graph-index project="RUTUBE Video Analyzer" version="0.1.0">
  <description>Knowledge graph — 11 modules, cross-links, exported types and functions</description>
  <Modules>
    <Module id="M-CORE" routed="GD-001-M-CORE.xml" name="Core Types &amp; Contracts" type="LIBRARY" status="built">
      <Purpose>Pydantic-модели, конфигурация, исключения, TimeoutManager, MemoryStore, метрики — общие для всех модулей</Purpose>
    </Module>
    <Module id="M-AUDIO" routed="GD-002-M-AUDIO.xml" name="Audio Engine" type="PROCESSOR" status="built">
      <Purpose>Извлечение аудио (ffmpeg subprocess), ASR (Whisper), диаризация, сборка таймлайна</Purpose>
    </Module>
    <Module id="M-VISION" routed="GD-003-M-VISION.xml" name="Vision Scanner" type="PROCESSOR" status="built">
      <Purpose>OCR (RapidOCR v4), GenreClassifier (LLM-driven), DomainRouter (жанровая блокировка VLM)</Purpose>
    </Module>
    <Module id="M-SEMANTIC" routed="GD-004-M-SEMANTIC.xml" name="Semantic Analyzer" type="PROCESSOR" status="built">
      <Purpose>SLM-анализ (gemma4:e4b), VLM Gatekeeper, извлечение точек монетизации</Purpose>
    </Module>
    <Module id="M-PASSPORT" routed="GD-005-M-PASSPORT.xml" name="Passport Builder" type="GENERATOR" status="built">
      <Purpose>Формирование YAML-frontmatter + Markdown-таймлайн с точками монетизации</Purpose>
    </Module>
    <Module id="M-SEARCH" routed="GD-006-M-SEARCH.xml" name="Semantic Search" type="PROCESSOR" status="built">
      <Purpose>Embedding-индексация сцен в ChromaDB и семантический поиск</Purpose>
    </Module>
    <Module id="M-MIXER" routed="GD-007-M-MIXER.xml" name="Mixer (Замеси)" type="PROCESSOR" status="built">
      <Purpose>Multi-video structured mix generation per user query</Purpose>
    </Module>
    <Module id="M-API" routed="GD-008-M-API.xml" name="API Layer" type="INTERFACE" status="built">
      <Purpose>FastAPI endpoints: загрузка, статус, результат, метрики. Управление job queue.</Purpose>
    </Module>
    <Module id="M-MODERATOR" routed="GD-009-M-MODERATOR.xml" name="Moderation Judge" type="PROCESSOR" status="built">
      <Purpose>LLM-as-Judge оценка контента: age_rating, вердикт, флаги нарушений.</Purpose>
    </Module>
    <Module id="M-EXTENSION" routed="GD-010-M-EXTENSION.xml" name="Chrome Extension (Замеси)" type="INTERFACE" status="built">
      <Purpose>Chrome MV3-расширение: инъекция Shadow DOM-панелей (монетизации, модерация, аудио, метрики) на страницу видео RUTUBE. Vanilla TS + Vite.</Purpose>
    </Module>
    <Module id="M-UI" routed="GD-011-M-UI.xml" name="React Dashboard (UI)" type="INTERFACE" status="built">
      <Purpose>React SPA: дашборд job queue, поиск сцен, просмотр паспорта, миксы. Demo/Real API-клиенты.</Purpose>
    </Module>
    <Module id="M-OFFERS" routed="GD-012-M-OFFERS.xml" name="Offers (Monetization)" type="PROCESSOR" status="built">
      <Purpose>Офферы монетизации: merch/travel/game/bike-search — детерминированная генерация, аддитивно к паспорту</Purpose>
    </Module>
    <Module id="M-STUDIO" routed="GD-013-M-STUDIO.xml" name="RUTUBE Studio" type="PROCESSOR" status="built">
      <Purpose>RUTUBE Studio — тренды Wordstat, реферальные bundles, продвижение, валидация автозаполнения</Purpose>
    </Module>
