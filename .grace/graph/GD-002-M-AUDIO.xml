    <Link target="M-CORE" relation="uses-types"/>
    <Link target="M-VISION" relation="feeds-iframes-to"/>
    <Link target="M-SEMANTIC" relation="feeds-into"/>
    <Link target="M-PASSPORT" relation="feeds-timeline-into"/>
  </CrossLinks>
  <Verification ref="V-M-AUDIO"/>
</module-graph>
