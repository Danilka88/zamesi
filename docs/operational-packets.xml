<?xml version="1.0" encoding="UTF-8"?>
<operational-packets project="RUTUBE Video Analyzer" version="0.1.0">
  <PacketTemplates>
    <ExecutionPacket>
      <field name="moduleId" type="string">M-XXX</field>
      <field name="purpose" type="string">Module purpose</field>
      <field name="writeScope" type="path">src/</field>
      <field name="contractExcerpt" type="xml">From development-plan.xml</field>
      <field name="verificationExcerpt" type="xml">From verification-plan.xml</field>
      <field name="assumptions" type="list"/>
      <field name="stopConditions" type="list"/>
      <field name="retryBudget" type="int">2</field>
    </ExecutionPacket>

    <GraphDelta>
      <field name="imports" type="list"/>
      <field name="publicExports" type="list"/>
      <field name="publicAnnotations" type="list"/>
      <field name="crossLinks" type="list"/>
    </GraphDelta>

    <VerificationDelta>
      <field name="testFiles" type="list"/>
      <field name="commands" type="list"/>
      <field name="requiredMarkers" type="list"/>
      <field name="phaseFollowUp" type="string"/>
    </VerificationDelta>

    <FailurePacket>
      <field name="contract" type="string"/>
      <field name="scenario" type="string"/>
      <field name="expectedEvidence" type="string"/>
      <field name="observedEvidence" type="string"/>
      <field name="firstDivergentPoint" type="string"/>
      <field name="suggestedAction" type="string"/>
    </FailurePacket>
  </PacketTemplates>
</operational-packets>
