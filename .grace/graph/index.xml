  <DataFlows>
    <Flow id="DF-001" name="Audio-First Pipeline">
      <description>MP4 → аудио → ASR → диаризация → таймлайн</description>
      <steps>M-AUDIO.extract_audio → M-AUDIO.transcribe → M-AUDIO.diarize → M-AUDIO.merge_timeline</steps>
    </Flow>
    <Flow id="DF-002" name="VLM Gatekeeper Flow">
      <description>Трёхуровневая фильтрация VLM-вызовов: жанр → requires_vision → OCR → Vision</description>
      <steps>M-VISION.extract_iframes → M-VISION.ocr_frame → M-VISION.detect_genre → M-SEMANTIC.analyze_scenes</steps>
    </Flow>
