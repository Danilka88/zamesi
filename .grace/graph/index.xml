      <description>Полный цикл: загрузка → пайплайн → результат</description>
      <steps>M-API.POST /analyze → DF-001 → DF-002 → DF-003 → M-API.GET /analyze/{id}/markdown</steps>
    </Flow>
    <Flow id="DF-005" name="Search Flow">
      <description>Passport → index → search</description>
      <steps>M-PASSPORT.build_passport → M-SEARCH.index_passport → M-SEARCH.search_scenes</steps>
    </Flow>
    <Flow id="DF-006" name="Mix Flow">
