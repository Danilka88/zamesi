    </Module>
    <Module id="M-SEMANTIC" routed="GD-004-M-SEMANTIC.xml" name="Semantic Analyzer" type="PROCESSOR" status="built">
      <Purpose>SLM-анализ (gemma4:e4b), VLM Gatekeeper, извлечение точек монетизации</Purpose>
    </Module>
    <Module id="M-PASSPORT" routed="GD-005-M-PASSPORT.xml" name="Passport Builder" type="GENERATOR" status="built">
