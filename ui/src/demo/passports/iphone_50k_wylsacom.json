        }
      ]
    },
    {
      "speaker": "Ведущий",
      "start_sec": 202,
      "end_sec": 210,
      "text": "Нам в России в целом похеру на Apple Intelligence. Но всё-таки это очень старый iPhone.",
      "word_timestamps": [
        {
          "word": "Нам",
          "start_sec": 202,
