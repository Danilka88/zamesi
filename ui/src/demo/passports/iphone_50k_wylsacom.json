          "start_sec": 338.4,
          "end_sec": 340
        },
        {
          "word": "офигенно",
          "start_sec": 340,
          "end_sec": 341.6
        }
      ]
    },
    {
      "speaker": "Ведущий",
      "start_sec": 357,
      "end_sec": 366,
      "text": "Новые стёкла поступили на все ваши любимые маркетплейсы. Заказываете на 17 Pro 3D-стекло от Дяди Валли.",
      "word_timestamps": [
        {
